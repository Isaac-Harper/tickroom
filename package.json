{
  "name": "tickroom",
  "version": "1.0.1",
  "description": "Authoritative realtime rooms on serverless: a leased fixed-timestep tick loop, a WebSocket relay, and Redis pub/sub as the bus.",
  "license": "MIT",
  "author": "Isaac Harper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Isaac-Harper/tickroom.git"
  },
  "homepage": "https://github.com/Isaac-Harper/tickroom#readme",
  "bugs": {
    "url": "https://github.com/Isaac-Harper/tickroom/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./server/memoryRedis": {
      "types": "./dist/server/memoryRedis.d.ts",
      "default": "./dist/server/memoryRedis.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./codec": {
      "types": "./dist/codec/index.d.ts",
      "default": "./dist/codec/index.js"
    },
    "./adapters/vercel": {
      "types": "./dist/adapters/vercel.d.ts",
      "default": "./dist/adapters/vercel.js"
    },
    "./adapters/node": {
      "types": "./dist/adapters/node.d.ts",
      "default": "./dist/adapters/node.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "TICKROOM_TIER=unit vitest run",
    "test:integration": "TICKROOM_TIER=integration TICKROOM_REQUIRE_REDIS=1 vitest run",
    "test:measure": "TICKROOM_TIER=measure TICKROOM_REQUIRE_REDIS=1 vitest run",
    "example:node": "tsx examples/node-server/server.ts"
  },
  "keywords": [
    "realtime",
    "multiplayer",
    "websocket",
    "redis",
    "serverless",
    "vercel",
    "netcode",
    "authoritative",
    "game-server",
    "pubsub"
  ],
  "peerDependencies": {
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "ioredis": "^5.11.1",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.9",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
